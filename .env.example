# ==========================================
# CORE API KEYS (REQUIRED)
# ==========================================
# Provide the key for the LLM provider configured in your .aitriage.yaml.

# Gemini (Default) - https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI - https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic - https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# ENTERPRISE SETTINGS (OPTIONAL)
# ==========================================
# JWT Secret for authenticating users. Change this in production!
JWT_SECRET=super-secret-development-key-change-in-prod
# Persistent SQLite database path
DB_PATH=/app/data/aitriage.db

# ==========================================
# DOCKER COMPOSE (OPTIONAL)
# ==========================================
# Directory the web service mounts at /host; projects to scan live under it.
# SCAN_ROOT=~/Documents/GitHub
# Project the MCP server (profile "agent") mounts read-only at /project.
# PROJECT_PATH=.
