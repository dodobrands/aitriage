# ==========================================
# AITRIAGE IGNORE FILE
# Works exactly like .gitignore. 
# Add paths here that the scanner should skip.
# ==========================================

# Third-party dependencies
vendor/
node_modules/
.git/

# Build and temporary artifacts
tmp/
build/
dist/

# Ignored by default in repo
examples/

# Detection rules and test-project configs: data that reads like findings when
# AITriage scans its own repository. Git still tracks them.
rules/**/secrets.yaml
**/testdata/**/aitriage.yaml
**/testdata/**/.aitriage.yaml
