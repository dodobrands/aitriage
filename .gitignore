# ==============================================================================
# AITriage — .gitignore
#
# This repository is public. Commit source, checked-in examples and test
# fixtures only. Never commit secrets, build output, dependencies, scan results
# or internal working notes.
#
# Internal docs, plans, handoffs and evidence live in .notes/ (never committed).
# The repository root holds public project files only.
#
# After editing this file, check that no tracked file became ignored:
#   git ls-files --cached --ignored --exclude-standard
# Only the force-tracked fixtures listed under "AITriage runtime" may appear.
# ==============================================================================


# ------------------------------------------------------------------------------
# Secrets & credentials (critical: public repository)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.envrc
!.env.example
!.env.*.example

*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
.netrc
credentials.json
gha-creds-*.json

secrets.*
# The scanner's own code and detection rules are named after what they detect.
!secrets.go
!/rules/**/secrets.yaml


# ------------------------------------------------------------------------------
# Internal workspace: docs, plans, handoffs, evidence
# ------------------------------------------------------------------------------
/.notes/

# Plans and handoffs created at the root by people or agents go to .notes/plans/.
/AITRIAGE_*.md
/*_PLAN.md
/*HANDOFF*.md

# Former locations of internal material, now merged into .notes/.
/local/
/artifacts/
/.codex-work/
/docs/
/enterprise/
/.jules/
/data/


# ------------------------------------------------------------------------------
# AITriage runtime: state, config, scan output
# ------------------------------------------------------------------------------
# Results and run bundles. `aitriage install-*` adds the same entry to scanned
# projects.
aitriage-reports/

# Per-project scan state. Force-tracked fixtures (git add -f), kept on purpose:
#   testdata/synthetic/fastapi-perfect/.aitriage/history/2026-05-12T*.json
.aitriage/

# Active config for this checkout. Templates (*.example) and test-project
# configs under testdata/ stay tracked.
/.aitriage.yaml
/.aitriage.yml
/aitriage.yaml
/aitriage.yml

# Reports written by `aitriage scan`, the TUI and the Action smoke test.
/aitriage-report.*
/aitriage-results.*


# ------------------------------------------------------------------------------
# Build output
# ------------------------------------------------------------------------------
# Go binaries: `make build` writes bin/, a bare `go build` writes ./aitriage.
/bin/
/aitriage
/aitriage_bin
/aitriage_dev
/tmp_aitriage
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Coverage profiles
*.out
coverage.txt
coverage.html

# Go workspaces are machine-local.
go.work
go.work.sum

# GoReleaser output and the web UI bundle.
/dist/
/web/dist/
*.tsbuildinfo

# The UI bundle copied next to the Go server for embedding. index.html is a
# tracked placeholder so `//go:embed ui/dist/*` compiles before the UI is built.
/internal/server/ui/dist/*
!/internal/server/ui/dist/index.html


# ------------------------------------------------------------------------------
# Dependencies & tool caches
# ------------------------------------------------------------------------------
node_modules/
.eslintcache
.cache/
.vite/
.parcel-cache/

# Python (helper scripts and vulnerable test apps)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/


# ------------------------------------------------------------------------------
# Logs & local databases
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3


# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
# Image exports (`docker save`)
*.tar
docker-compose.override.yml
docker-compose.override.yaml


# ------------------------------------------------------------------------------
# Scratch, merge & backup leftovers
# ------------------------------------------------------------------------------
/scratch/
/output.html
/output.txt
/scan_audit.txt
/ansi2html.sh
/fix_*.py
/max-*.txt

*.orig
*.rej
*.bak
*.tmp


# ------------------------------------------------------------------------------
# AI agents (machine-local config with absolute paths)
# ------------------------------------------------------------------------------
# Written by `aitriage install-codex` / `install-claude-code`.
/.codex/
/.mcp.json
/.claude/settings.local.json
/CLAUDE.local.md
/.gemini/
.aider*


# ------------------------------------------------------------------------------
# Editors & IDEs
# ------------------------------------------------------------------------------
.idea/
.vscode/
.fleet/
.zed/
.cursor/
.windsurf/
*.code-workspace
*.swp
*.swo
*~


# ------------------------------------------------------------------------------
# Operating systems
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*
