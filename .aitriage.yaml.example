# AITriage Configuration Template
# Copy this file to '.aitriage.yaml' in your project root.
# Environment variables are supported using $VAR or ${VAR} syntax.
# Docs: https://github.com/dodobrands/aitriage

# ─── LLM Integration (optional, for aitriage agent/fix) ───────────────────────
llm:
  # Supported providers: gemini | openai | anthropic | ollama | groq
  provider: gemini

  # The model used for deep analysis and remediation. Verdicts differ between
  # models on the same code, so the fail_on: confirmed gate depends on this
  # choice: pin one model and re-check a known project before switching.
  # Left unset, the provider's default applies: gemini-3.5-flash-lite
  # (gemini), claude-sonnet-5-5 (anthropic), gpt-4o (openai; gpt-6-luna from
  # AITriage 1.16); groq and ollama need a model. A default moves when its
  # provider retires the model.
  model: gemini-3.5-flash-lite

  # NEVER hardcode keys here. Always use environment variables.
  api_key: $GEMINI_API_KEY

  # Findings per classification request (default 40; AITRIAGE_BATCH_SIZE wins).
  # Weaker models drop items from long requests; such batches are retried in halves.
  # batch_size: 40

  # Sampling temperature, 0 to 2 (default 0, so the same finding gets the same
  # verdict on every run), or "default" to send none and keep the provider's own.
  # Models that take no temperature get none: OpenAI o-series, GPT-5 and GPT-6,
  # Gemini 3 and later, Claude models after Opus 4.6. AITRIAGE_LLM_TEMPERATURE
  # and --temperature win.
  # temperature: 0

# ─── Ignore Rules ─────────────────────────────────────────────────────────────
ignore:
  # Rule IDs dropped from every source: built-in rules and heuristics, Semgrep,
  # Trivy, Gitleaks, Bandit, NFR, deploy and network checks. IDs compare whole,
  # ignoring case. A bare ID matches any source; a prefix limits it to one:
  # "gitleaks:generic-api-key", "trivy:CVE-2024-1234", "semgrep:<check-id>",
  # "bandit:B105", and "core:", "nfr:", "deploy:", "network:" for AITriage's own
  # checks (e.g. "deploy:nginx_missing_csp", "network:port-5432"). A Trivy
  # Kubernetes or Dockerfile check matches in any spelling Trivy has used:
  # "KSV012", "KSV-0012" and "AVD-KSV-0012" are one check, as are "DS002",
  # "DS-0002" and "AVD-DS-0002"; other ids compare as written.
  # "deploy:compose_default_credential" silences default passwords in Compose
  # files and keeps the other hardcoded secrets.
  rules: []   # e.g. ["ENTR-12", "gitleaks:generic-api-key"]

  # Paths every scanner skips (the built-in engine, Semgrep, Trivy, Gitleaks,
  # Bandit, NFR and deploy checks, the git-history scan): .gitignore syntax,
  # relative to the project root, like .aitriageignore. "legacy/" matches that
  # directory at any depth, "/legacy/" only at the root. Git-ignored files and
  # vendored or generated directories (node_modules, vendor, dist, .next,
  # __pycache__, venv) are skipped already; a committed build/ is scanned.
  paths: []   # e.g. ["/third_party/", "**/*.pb.go"]

# To silence one place instead of a whole rule, comment in the source:
#   x = "fixture"  # aitriage-ignore: B105, gitleaks:generic-api-key (reason)
#   # aitriage-ignore-next-line: PY-SUBPROCESS
#   # aitriage-ignore-file: ENTR-12   (first 10 lines; without IDs, every rule)
# aitriage-ignore covers its own line and the next. "all" silences every rule
# only as an ID of its own; text after the ID list is never read as an ID.

# ─── Security Policy Gate ────────────────────────────────────────────────────
# This is the CI/CD answer to: can this project pass its security requirements?
health_check:
  # profile: baseline | standard | strict
  #   - baseline: compatible default; blocks active CRITICAL/HIGH by fail_on
  #   - standard: for sensitive/business apps; also enforces minimum_score 70
  #   - strict: for high-assurance systems; blocks any active finding
  profile: baseline

  # When to exit 1 (blocks the CI/CD job): critical | any | confirmed | never
  #   critical: active CRITICAL/HIGH findings; any: every active finding;
  #   confirmed: only findings AI triage confirmed (aitriage agent); never: report only.
  # If AI triage cannot finish, the gate fails (triage_incomplete) under every
  # value except never, and aitriage agent exits 2.
  fail_on: critical

  # With fail_on: confirmed, block only confirmed findings at or above this
  # severity: LOW (default: every confirmed finding) | MEDIUM | HIGH | CRITICAL
  confirmed_min_severity: LOW

  # Accept an AI false-positive verdict for a CRITICAL finding only when the
  # model reports high confidence; otherwise keep it for manual review.
  fp_critical_requires_high_confidence: false

  # IaC misconfigurations found by Trivy (Dockerfile, Kubernetes, Terraform):
  #   report (default): triaged and shown in the summary, the report and
  #     triage-findings.json, but not scored and not gating;
  #   block: scored and gating like any other finding.
  # A finding that another check also reported (DOCKER-NO-USER and Trivy's
  # DS-0002), or that block_sources or block_classes below names, gates
  # either way. report stays the default throughout v1; a default change
  # follows the compatibility policy in CONTRIBUTING.md.
  iac_findings: report

  # Code-quality findings with no security impact, at LOW or INFO: rules of
  # subcategory quality (built in: ENTR-04 and ENTR-AI-RESIDUE, AI chat
  # residue in comments; ENTR-ZOMBIE-CODE, commented-out code; ENTR-07;
  # ENTR-12, file length; FAST-SYNC-ASYNC) and a missing .env.example:
  #   block (default): scored and gating like any other finding, as before
  #     this setting existed;
  #   report: triaged and shown like IaC findings above, but not scored and
  #     not gating. Also --quality-findings on agent and scan.
  # A finding that a security check also reported, a MEDIUM or more severe
  # one whatever its rule's subcategory, and one that block_sources or
  # block_classes below names gate either way. A swallowed exception
  # (FAST-LAZY-EXC, Bandit B110/B112) is never code quality: it can turn a
  # failed security check into a pass. block stays the default throughout v1.
  quality_findings: block

  # Fail if the Health Check score is below this threshold (0 disables score gating)
  minimum_score: 0

  # Specific threshold overrides (-1 = unlimited, 0 = block any active finding of this severity)
  max_critical: -1
  max_high: -1
  max_medium: -1

  # Expose block lists for specific rules/classes/sources. An entry here wins
  # over iac_findings: report and quality_findings: report for the findings
  # it names. A Trivy Kubernetes or Dockerfile check matches in each spelling
  # Trivy has used, as in ignore.rules above.
  block_sources: []  # e.g., ["gitleaks"]
  block_classes: []  # e.g., ["hardcoded-secret"]

# ─── Bundled Scanner Options (optional) ──────────────────────────────────────
# Trivy also applies the project's own .trivyignore (or .trivyignore.yaml, which
# wins when both exist) from the repository root, to dependency and IaC scans.
# scanners:
#   trivy:
#     ignore_unfixed: true        # dependency scan: only vulnerabilities with a fixed version
#     severity: [CRITICAL, HIGH]  # both scans; UNKNOWN, LOW, MEDIUM, HIGH, CRITICAL (a typo fails the Trivy run)

# ─── Legacy Failure Thresholds (fallback) ─────────────────────────────────────
# Still supported when the health_check block is not configured.
strict_mode: false   # Set true to fail on ANY finding
fail_score: 0        # Fail if Health Check score < this (0 = disabled)

# ─── Custom Rules Engine (optional) ───────────────────────────────────────────
# Add your own project-specific rules here.
# rules:
#   - id: CUSTOM-NO-CONSOLE-LOG
#     name: "Direct console.log in production code"
#     stack: nextjs
#     extensions: [".ts", ".tsx"]
#     target: code
#     pattern: 'console\.log\('
#     suggestion: "Use a structured logger instead of console.log in production."
#     severity: "LOW"
