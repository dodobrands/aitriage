# ==============================================================================
# AITriage — .dockerignore
#
# The build context is the repository root, and the go-builder stage runs
# `COPY . .`. The image needs only go.mod, go.sum, cmd/, internal/, rules/,
# web/ (without node_modules and dist) and entrypoint.sh. Everything below
# stays out of every build layer.
#
# Patterns are relative to the repository root; use **/ to match at any depth.
# Never exclude files under rules/: `//go:embed all:*` ships all of them.
# ==============================================================================


# ------------------------------------------------------------------------------
# Version control & CI
# ------------------------------------------------------------------------------
.git
.github


# ------------------------------------------------------------------------------
# Secrets & machine-local config
# ------------------------------------------------------------------------------
**/.env
**/.env.*
**/*.pem
**/*.key
.aitriage.yaml
.aitriage.yml
aitriage.yaml
aitriage.yml
.codex
.claude
.mcp.json
.gemini
.jules


# ------------------------------------------------------------------------------
# Internal workspace, scan state & reports
# ------------------------------------------------------------------------------
.notes
.codex-work
artifacts
docs
enterprise
reports
scratch
tmp
stitch_*
CLAUDE.md
AITRIAGE_*.md
*_PLAN.md
*HANDOFF*.md
**/.aitriage
**/aitriage-reports
aitriage-report.*
aitriage-results.*


# ------------------------------------------------------------------------------
# Build output & dependencies (rebuilt inside the image)
# ------------------------------------------------------------------------------
bin
dist
aitriage
tmp_aitriage
**/node_modules
web/dist


# ------------------------------------------------------------------------------
# Test fixtures (not part of the image)
# ------------------------------------------------------------------------------
testdata


# ------------------------------------------------------------------------------
# Editors & OS
# ------------------------------------------------------------------------------
.idea
.vscode
**/*.swp
**/.DS_Store
